# Production/local PostgreSQL. Omit to use data/slipstream.db with SQLite.
DATABASE_URL=postgresql+psycopg://slipstream:slipstream@localhost:5432/slipstream
POSTGRES_DB=slipstream
POSTGRES_USER=slipstream
POSTGRES_PASSWORD=slipstream
POSTGRES_PORT=5432

SLIPSTREAM_DATA_ROOT=./data
SLIPSTREAM_MODEL_ROOT=./data/models
SLIPSTREAM_CACHE_ROOT=./data/cache
SLIPSTREAM_IMPORT_BATCH_SIZE=5000

SLIPSTREAM_FORZA_IP=127.0.0.1
SLIPSTREAM_FORZA_PORT=5300
SLIPSTREAM_RESAMPLE_POINTS=400

# Optional research detectors; defaults to false (seven product detectors).
SLIPSTREAM_EXPERIMENTAL_DETECTORS=false
